# ============================================================
# .env.example — все переменные окружения VK Mini App.
# Скопируйте в `.env.local` и заполните своими значениями.
# ============================================================

# URL вашего опубликованного Google Apps Script (веб-приложение).
# Получается при деплое скрипта (Deploy → New deployment → Web app).
# Пример: https://script.google.com/macros/s/AKfycb.../exec
NEXT_PUBLIC_SHEETS_API_URL=

# Пароль для входа в админ-панель (/admin).
# В коде хранится SHA-256-хеш этого пароля.
# Сгенерировать хеш: см. README → раздел "Настройка админки".
NEXT_PUBLIC_ADMIN_PASSWORD_HASH=

# (Опционально) VK service_token для проверки репостов на сервере (в Apps Script).
# НЕ пишите сюда — вводится в Script Properties Apps Script, не в фронт.
# Здесь только для документации.
# VK_SERVICE_TOKEN=

# basePath для GitHub Pages. = путь репозитория.
# Например, для https://username.github.io/vk-contest-mini-app/ → /vk-contest-mini-app
# Для корневого домена → пустая строка.
NEXT_PUBLIC_BASE_PATH=/vk-contest-mini-app

# ID приложения VK (для VK Bridge, обычно не нужен в env — настраивается в VK Mini Apps).
NEXT_PUBLIC_VK_APP_ID=

# Режим разработки: true = mock-данные, VK Bridge отключён, API не вызывается.
# Удобно для локального просмотра без VK.
NEXT_PUBLIC_MOCK_MODE=false

# Список ID карточек для пребилда (для статического экспорта /quiz/[id]).
# Через запятую: 1,2,3. Новые карточки после деплоя требуют пересборку.
NEXT_PUBLIC_PREBUILD_CARD_IDS=1,2,3
