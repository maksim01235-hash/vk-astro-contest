{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "external_directory": "deny",
    "webfetch": "allow",
    "bash": {
      "*": "allow",

      "git push origin main": "deny",
      "git push origin main *": "deny",
      "git push origin master": "deny",
      "git push origin master *": "deny",
      "git push --force*": "deny",
      "git push -f *": "deny",

      "git switch main": "ask",
      "git checkout main": "ask",
      "git switch master": "ask",
      "git checkout master": "ask",

      "git merge *": "ask",
      "git rebase *": "ask",

      "git reset --hard*": "ask",
      "git clean*": "ask",

      "rm *": "ask",
      "rmdir *": "ask",
      "del *": "ask",

      "npm publish*": "ask",
      "npx npm publish*": "ask"
    }
  }
}